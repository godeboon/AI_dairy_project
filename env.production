# 프로덕션 환경 설정
ENVIRONMENT=production

# 데이터베이스 설정
DATABASE_URL=sqlite:///./app.db

# API 키 설정 (실제 값으로 교체 필요)
OPENAI_API_KEY=your-openai-api-key-here
MIXTRAL_TOKEN=your-mixtral-token-here
MIXTRAL_ENDPOINT=https://api.mixtral.com/v1/chat/completions

# 보안 설정 (실제 값으로 교체 필요)
SECRET_KEY=your-super-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis 설정 (Docker 서비스명 사용)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Chroma 설정 (Docker 서비스명 사용)
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_PATH=/chroma/chroma
CHROMA_ALLOW_RESET=false

# 애플리케이션 설정
APP_NAME=Matabus Chat API
DEBUG=false
LOG_LEVEL=INFO

# 성능 설정
RATE_LIMIT_PER_MINUTE=60
MAX_CONCURRENT_REQUESTS=10
